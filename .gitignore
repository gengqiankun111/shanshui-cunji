# Generated by Cargo
# will have compiled files and executables
debug/
target/

# 本机构建配置（含绝对路径，不入库）
.cargo/

# proptest 生成的失败回归样本（CI 失败时按需提交）
proptest-regressions/

# 运行时数据目录
data/

# cargo vendor 离线包（服务器构建用，本机临时产物不入库）
vendor/

# 开发点独立研究 demo（demo-first 流程：src/demo/<点>/* 研究跑通后再整合进 kernel，不提交）
src/demo/

# 测试辅助脚本（function_test：demo/压测运行脚本 + 截图脚本；不提交，仓库内保留 demo 主代码 src/demo.rs）
function_test/

# Cargo.lock 是二进制项目的一部分，必须入库以锁定依赖版本
# Cargo.lock

# ---- 性能基准/测试结果产物（可再生成；要点名入库存档的 summary 除外，已跟踪文件不受 ignore 影响）----
# sqlrun/压测结果目录（results-*、results-dbg 等历史轮次）
results-*/
results*/
# rr-conformance 运行日志与结果
rr-conformance/results-*.log
# 通用日志与 Python 缓存
*.log
__pycache__/
*.pyc
# 仓库根编译产物（构建后替换的服务器可执行文件，不入库）
/cjserver.exe
/shanshui-cunji-mysql-server.exe
