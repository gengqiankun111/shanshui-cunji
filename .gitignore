# Generated by Cargo
# will have compiled files and executables
debug/
target/

# 本机构建配置（含绝对路径，不入库）
.cargo/

# proptest 生成的失败回归样本（CI 失败时按需提交）
proptest-regressions/

# 运行时数据目录
data/

# cargo vendor 离线包（服务器构建用，本机临时产物不入库）
vendor/

# 开发点独立研究 demo（demo-first 流程：src/demo/<点>/* 研究跑通后再整合进 kernel，不提交）
src/demo/

# 测试辅助脚本（function_test：demo/压测运行脚本 + 截图脚本；不提交，仓库内保留 demo 主代码 src/demo.rs）
function_test/

# Cargo.lock 是二进制项目的一部分，必须入库以锁定依赖版本
# Cargo.lock
